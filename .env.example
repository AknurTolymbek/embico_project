# Docker Compose reads this file from the project root, not backend/.env.
INSTALL_ML=true
ML_ENABLED=true
ML_DEVICE=cpu
ML_WEIGHTS_DIR=./ml-model/weights

SECRET_KEY=

# Set these in the ROOT .env before first Docker startup. Never commit passwords.
FIRST_SUPERUSER_LOGIN=admin
FIRST_SUPERUSER_PASSWORD=
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_FIRST_NAME=Администратор
FIRST_SUPERUSER_LAST_NAME=Клиники
AUTH_COOKIE_SECURE=false
