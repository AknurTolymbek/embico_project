# Database
POSTGRES_USER=embico_user
POSTGRES_PASSWORD=embico_password
POSTGRES_DB=embico_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL
DATABASE_URL=postgresql://embico_user:embico_password@localhost:5432/embico_db

# Application
APP_NAME=EMBICO Platform
APP_VERSION=0.1.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (разрешённые origins для фронтенда)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# First superuser (для создания первого пользователя)
FIRST_SUPERUSER_EMAIL=admin@embico.kz
FIRST_SUPERUSER_PASSWORD=changeme123
FIRST_SUPERUSER_ROLE=reproductologist
